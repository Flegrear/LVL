<!-- LVL's extension runner: stdout carries the protocol, so logs go to stderr. -->
<configuration>
  <appender name="ERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>[runner] %level %logger{20}: %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="ERR" />
  </root>
</configuration>
